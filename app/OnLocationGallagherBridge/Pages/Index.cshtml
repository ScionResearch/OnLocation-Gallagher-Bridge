@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-4">
    <h1 class="display-5">OnLocation–Gallagher Bridge</h1>
    <p class="text-muted">Status and recent activity</p>
</div>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Profiles</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.Profiles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                @p.Id
                                @if (!p.InitialMatchCompleted)
                                {
                                    <small class="d-block text-muted">Initial match not confirmed</small>
                                }
                            </span>
                            <span class="d-flex align-items-center gap-2">
                                <span class="badge bg-@(p.Enabled ? "success" : "secondary")">@(p.Enabled ? "on" : "off")</span>
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="profileId" value="@p.Id" />
                                    <input type="hidden" name="enable" value="@((!p.Enabled).ToString().ToLowerInvariant())" />
                                    <button type="submit" class="btn btn-sm btn-outline-@(p.Enabled ? "secondary" : "primary")">@(p.Enabled ? "Turn off" : "Turn on")</button>
                                </form>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Queue</h5>
                <p class="card-text">Pending: <strong>@Model.PendingJobs</strong></p>
                <p class="card-text">Failed: <strong>@Model.FailedJobs</strong></p>
                <p class="card-text">Manual matches: <strong>@Model.ManualMatches</strong></p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Health</h5>
                <p class="card-text">OnLocation: <span class="badge bg-@(Model.OnLocationOk ? "success" : "danger")">@(Model.OnLocationOk ? "OK" : "Fail")</span></p>
                <p class="card-text">Gallagher: <span class="badge bg-@(Model.GallagherOk ? "success" : "danger")">@(Model.GallagherOk ? "OK" : "Fail")</span></p>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">Recent Audit Events</h4>
<table class="table table-sm table-striped">
    <thead>
        <tr><th>Time</th><th>Profile</th><th>Source</th><th>Action</th><th>Detail</th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model.RecentAudit)
        {
            <tr>
                <td>@a.Timestamp.ToLocalTime().ToString("g")</td>
                <td>@a.ProfileId</td>
                <td>@a.SourceId</td>
                <td>@a.Action</td>
                <td>@(a.Message ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
