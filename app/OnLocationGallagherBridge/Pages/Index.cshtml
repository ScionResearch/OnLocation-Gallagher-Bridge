@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-4">
    <h1 class="display-5">OnLocation–Gallagher Bridge</h1>
    <p class="text-muted">Status and recent activity</p>
</div>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Health</h5>
                <div class="row g-3">
                    <div class="col-md-6 border-end">
                        <h6 class="card-subtitle mb-2 text-muted">Connection State</h6>
                        <p class="card-text mb-1">OnLocation: <span class="status-text text-@(Model.OnLocationOk ? "success" : "danger")">@(Model.OnLocationOk ? "OK" : "Fail")</span></p>
                        <p class="card-text mb-0">Gallagher: <span class="status-text text-@(Model.GallagherOk ? "success" : "danger")">@(Model.GallagherOk ? "OK" : "Fail")</span></p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="card-subtitle mb-2 text-muted">Settings State</h6>
                        <p class="mb-1">
                            <strong>Overall:</strong> <partial name="_ConfigurationStatus" model="Model.OverallStatus.Overall" />
                        </p>
                        <ul class="list-inline mb-0 small">
                            <li class="list-inline-item">Connector settings: <partial name="_ConfigurationStatus" model="Model.OverallStatus.ConnectorSettings" /></li>
                            <li class="list-inline-item">Field mapping: <partial name="_ConfigurationStatus" model="Model.OverallStatus.FieldMapping" /></li>
                            <li class="list-inline-item">Initial record match: <partial name="_ConfigurationStatus" model="Model.OverallStatus.InitialMatch" /></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Record Groups</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.Profiles)
                    {
                        var collapseId = $"profile-collapse-{p.Id}";
                        var mappingStatus = Model.ProfileMappingStatus.GetValueOrDefault(p.Id);
                        var initialStatus = Model.ProfileInitialMatchStatus.GetValueOrDefault(p.Id);
                        var configured = mappingStatus == ConfigurationStatus.Complete && initialStatus == ConfigurationStatus.Complete;
                        var (profileStatus, profileStatusClass) = configured
                            ? (p.Enabled ? ("All OK", "success") : ("Disabled", "secondary"))
                            : (mappingStatus == ConfigurationStatus.NotConfigured && initialStatus == ConfigurationStatus.NotConfigured)
                                ? ("Not configured", "secondary")
                                : ("Incomplete Config", "warning");
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>
                                    <strong>@RecordGroupDisplay.GetName(p.Id)</strong>
                                    <span class="status-text text-@profileStatusClass ms-2">@profileStatus</span>
                                </span>
                                @if (configured)
                                {
                                    <form method="post" asp-page-handler="Toggle" class="d-inline form-check form-switch m-0">
                                        <input type="hidden" name="profileId" value="@p.Id" />
                                        <input class="form-check-input" type="checkbox" role="switch" id="enable-@p.Id" name="enable" value="true" @(p.Enabled ? "checked" : "") onchange="this.form.submit()" />
                                        <label class="form-check-label" for="enable-@p.Id">Sync enabled</label>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                        Expand <span aria-hidden="true">&#9660;</span>
                                    </button>
                                }
                            </div>
                            <div class="mt-2 collapse @(configured ? "show" : "")" id="@collapseId">
                                <div class="d-flex justify-content-between align-items-start">
                                    <small class="text-muted">
                                        Last run @(p.LastRun?.ToLocalTime().ToString("g") ?? "never")<br />
                                        Next fast run @(p.Enabled ? (p.NextRun?.ToLocalTime().ToString("g") ?? "on the next tick") : "paused")<br />
                                        Next full run @(p.Enabled ? (p.NextFullRun?.ToLocalTime().ToString("g") ?? "on the next tick") : "paused")
                                    </small>
                                    <form method="post" asp-page-handler="Schedule" class="d-flex flex-wrap gap-2 align-items-center schedule-form">
                                        <input type="hidden" name="profileId" value="@p.Id" />
                                        <label class="form-label mb-0 small text-nowrap">Fast</label>
                                        <select name="fastMinutes" class="form-select form-select-sm" style="width: 7rem;">
                                            @foreach (var option in IndexModel.IntervalOptions)
                                            {
                                                <option value="@option.Minutes" selected="@(option.Minutes == p.FastSyncIntervalMinutes)">@option.Label</option>
                                            }
                                        </select>
                                        <label class="form-label mb-0 small text-nowrap">Full</label>
                                        <select name="fullDays" class="form-select form-select-sm" style="width: 7rem;">
                                            @foreach (var option in IndexModel.FullIntervalOptions)
                                            {
                                                <option value="@option.Days" selected="@(option.Days == p.FullSyncIntervalDays)">@option.Label</option>
                                            }
                                        </select>
                                        <input type="time" name="fullTime" value="@TimeSpan.FromMinutes(p.FullSyncTimeOfDayMinutes).ToString("hh\\:mm")" class="form-control form-control-sm" style="width: 6rem;" />
                                        <input type="number" name="fullMonths" min="0" max="120" value="@(p.FullSyncLookbackMonths ?? 0)" class="form-control form-control-sm" style="width: 4rem;" title="Lookback months (0 = all records)" />
                                        <span class="small text-nowrap">mo</span>
                                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Apply</button>
                                    </form>
                                </div>
                                @if (configured)
                                {
                                    <div class="d-flex justify-content-end gap-2 mt-2">
                                        <form method="post" asp-page-handler="RunFast" class="d-inline">
                                            <input type="hidden" name="profileId" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Run fast sync now</button>
                                        </form>
                                        <form method="post" asp-page-handler="RunFull" class="d-inline">
                                            <input type="hidden" name="profileId" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary" onclick="return confirm('A full sync scans the configured lookback window and may take a long time. Continue?');">Run full sync now</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex gap-2 mt-2">
                                        @if (mappingStatus != ConfigurationStatus.Complete)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" asp-page="/Mapping">Configure mapping</a>
                                        }
                                        @if (initialStatus != ConfigurationStatus.Complete)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" asp-page="/MatchReview">Confirm initial match</a>
                                        }
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Queue</h5>
                <p class="card-text">Pending: <strong>@Model.PendingJobs</strong></p>
                <p class="card-text">
                    Failed: <strong class="text-@(Model.FailedJobs > 0 ? "danger" : "body")">@Model.FailedJobs</strong>
                    @if (Model.FailedJobs > 0)
                    {
                        <a asp-page="/Exceptions" class="ms-2">Review exceptions</a>
                    }
                </p>
                <p class="card-text">
                    Manual matches: <strong>@Model.ManualMatches</strong>
                    @if (Model.ManualMatches > 0)
                    {
                        <a asp-page="/MatchReview" class="ms-2">Resolve</a>
                    }
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 shadow-sm" id="activity-card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                Sync Activity
                <span class="status-text text-secondary ms-2" id="activity-state">@(Model.Activity.Running ? "running" : "idle")</span>
            </h5>
            <small class="text-muted" id="activity-elapsed">@(Model.Activity.Running ? Model.Activity.Elapsed : "")</small>
        </div>
        <p class="mb-1 mt-2"><strong id="activity-phase">@Model.Activity.Phase</strong> <span id="activity-profile" class="text-muted">@(Model.Activity.ProfileId == null ? "" : $"({RecordGroupDisplay.GetName(Model.Activity.ProfileId)})")</span></p>
        <p class="mb-2 text-muted small" id="activity-detail">@(Model.Activity.Detail ?? Model.Activity.LastRunSummary ?? "Waiting for the next scheduled run.")</p>
        <p class="mb-2 text-muted small" id="activity-next-run">Next fast run: @(Model.NextRunProfileId != null ? $"{RecordGroupDisplay.GetName(Model.NextRunProfileId)} " : "")@(Model.NextRun.HasValue && Model.NextRun.Value <= DateTimeOffset.Now ? "due now" : (Model.NextRun?.ToLocalTime().ToString("g") ?? "not scheduled"))</p>
        <p class="mb-2 text-muted small" id="activity-next-full-run">Next full run: @(Model.NextFullRunProfileId != null ? $"{RecordGroupDisplay.GetName(Model.NextFullRunProfileId)} " : "")@(Model.NextFullRun.HasValue && Model.NextFullRun.Value <= DateTimeOffset.Now ? "due now" : (Model.NextFullRun?.ToLocalTime().ToString("g") ?? "not scheduled"))</p>
        <div class="progress mb-2" style="height: 0.5rem;">
            <div class="progress-bar" id="activity-bar" role="progressbar" style="width: @(Model.Activity.Total > 0 ? Model.Activity.Processed * 100 / Model.Activity.Total : 0)%"></div>
        </div>
        <div class="d-flex gap-3 small text-muted">
            <span>Induction records checked: <strong id="activity-checked">@Model.Activity.RecordsChecked</strong></span>
            <span>People affected: <strong id="activity-matched">@Model.Activity.RecordsMatched</strong></span>
            <span>Written: <strong id="activity-processed">@Model.Activity.Processed</strong> of <span id="activity-total">@Model.Activity.Total</span></span>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4">
    <h4 class="mb-0">Recent Activity</h4>
    <a asp-page="/Audit">Full audit log</a>
</div>
<table class="table table-sm table-striped align-middle">
    <thead>
        <tr><th>Time</th><th>Record</th><th>Record Group</th><th>Action</th><th>Outcome</th><th>What happened</th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model.RecentAudit)
        {
            <tr>
                <td class="text-nowrap">@a.Timestamp.ToLocalTime().ToString("g")</td>
                <td>
                    <strong>@(a.SourceDisplay ?? a.SourceId)</strong>
                    <small class="d-block text-muted">id @a.SourceId</small>
                </td>
                <td>@RecordGroupDisplay.GetName(a.ProfileId)</td>
                <td><span class="status-text text-@AuditModel.ActionColour(a.Action)">@a.Action</span></td>
                <td><span class="status-text text-@AuditModel.OutcomeColour(a.Outcome)">@a.Outcome</span></td>
                <td>
                    @(a.Message ?? "—")
                    @if (!string.IsNullOrWhiteSpace(a.Error))
                    {
                        <small class="d-block text-danger">@a.Error</small>
                    }
                </td>
            </tr>
        }
        @if (!Model.RecentAudit.Any())
        {
            <tr><td colspan="6" class="text-muted">No records have been processed yet.</td></tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        (function () {
            var wasRunning = @(Model.Activity.Running ? "true" : "false");

            function text(id, value) {
                var el = document.getElementById(id);
                if (el) el.textContent = value;
            }

            async function poll() {
                try {
                    var response = await fetch('?handler=Activity', { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) return;
                    var a = await response.json();

                    var state = document.getElementById('activity-state');
                    state.textContent = a.running ? 'running' : 'idle';
                    state.className = 'status-text ms-2 ' + (a.running ? 'text-primary' : 'text-secondary');

                    text('activity-phase', a.phase);
                    text('activity-profile', a.profileId ? '(' + a.profileId + ')' : '');
                    text('activity-detail', a.detail || a.lastRunSummary || 'Waiting for the next scheduled run.');
                    text('activity-elapsed', a.running ? a.elapsed : (a.lastRunFinishedAt ? 'last run ' + a.lastRunFinishedAt : ''));
                    text('activity-checked', a.recordsChecked);
                    text('activity-matched', a.recordsMatched);
                    text('activity-processed', a.processed);
                    text('activity-total', a.total);

                    var bar = document.getElementById('activity-bar');
                    bar.style.width = (a.total > 0 ? Math.round(a.processed * 100 / a.total) : (a.running ? 100 : 0)) + '%';
                    bar.className = 'progress-bar' + (a.running && a.total === 0 ? ' progress-bar-striped progress-bar-animated' : '');

                    // The queue counts and audit table are rendered server-side, so refresh once a run ends.
                    if (wasRunning && !a.running) { window.location.reload(); return; }
                    wasRunning = a.running;
                } catch (e) {
                    // A failed poll is not worth surfacing; the next one will retry.
                }
            }

            poll();
            setInterval(poll, 2000);

            // Disable schedule Apply buttons until a value changes.
            document.querySelectorAll('form.schedule-form').forEach(function (form) {
                var btn = form.querySelector('button[type="submit"]');
                if (btn) btn.disabled = true;
                form.addEventListener('input', function () {
                    if (btn) btn.disabled = false;
                });
            });
        })();
    </script>
}
