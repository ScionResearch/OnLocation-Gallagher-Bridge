@page
@model ExceptionsModel
@{
    ViewData["Title"] = "Exceptions";
}

<div class="page-header d-flex justify-content-between align-items-start">
    <div>
        <h2>Exceptions</h2>
        <p class="text-muted mb-0">Records that could not be written to Command Centre, grouped by cause.</p>
    </div>
    @if (Model.Groups.Any())
    {
        <form method="post" asp-page-handler="DismissAll">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Dismiss all</button>
        </form>
    }
</div>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-danger shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Failing records</h6>
                <div class="display-6">@Model.Groups.Sum(g => g.Count)</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Waiting for a manual match</h6>
                <div class="display-6">@Model.PendingManualMatches</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Links repaired automatically</h6>
                <div class="display-6">@Model.StaleLinks</div>
                <small class="text-muted">Cardholders that had been deleted in Command Centre</small>
            </div>
        </div>
    </div>
</div>

@if (!Model.Groups.Any())
{
    <div class="alert alert-success">Nothing is failing at the moment.</div>
}

@foreach (var group in Model.Groups)
{
    var groupId = $"group-{Math.Abs(group.Summary.GetHashCode())}";
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-danger me-2">@group.Count</span>
                <code>@group.Summary</code>
            </div>
            <form method="post" asp-page-handler="RetryGroup" class="ms-2">
                <input type="hidden" name="summary" value="@group.Summary" />
                <button type="submit" class="btn btn-sm btn-outline-primary">Retry all @group.Count</button>
            </form>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(group.Advice))
            {
                <p class="mb-3"><strong>What to do:</strong> @group.Advice</p>
            }
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Record</th>
                        <th>Record Group</th>
                        <th>Attempted</th>
                        <th>Last tried</th>
                        <th>Retries</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in group.Rows)
                    {
                        var detailId = $"detail-{row.JobId:N}";
                        <tr>
                            <td>
                                <strong>@row.Display</strong>
                                <small class="d-block text-muted">OnLocation id @row.SourceId</small>
                            </td>
                            <td>@RecordGroupDisplay.GetName(row.ProfileId)</td>
                            <td>
                                @row.Attempted
                                @if (!string.IsNullOrWhiteSpace(row.GallagherHref))
                                {
                                    <small class="d-block text-muted">@row.GallagherHref</small>
                                }
                            </td>
                            <td>@row.UpdatedAt.ToLocalTime().ToString("g")</td>
                            <td>@row.RetryCount</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#@detailId">Detail</button>
                                <form method="post" asp-page-handler="Retry" class="d-inline">
                                    <input type="hidden" name="jobId" value="@row.JobId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Retry</button>
                                </form>
                                <form method="post" asp-page-handler="Rematch" class="d-inline">
                                    <input type="hidden" name="jobId" value="@row.JobId" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Unlink and re-match</button>
                                </form>
                                <form method="post" asp-page-handler="Dismiss" class="d-inline">
                                    <input type="hidden" name="jobId" value="@row.JobId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Dismiss</button>
                                </form>
                            </td>
                        </tr>
                        <tr class="collapse" id="@detailId">
                            <td colspan="6">
                                <h6>Error returned by Command Centre</h6>
                                <pre class="bg-light p-2 small">@(row.Error ?? "—")</pre>
                                <h6>OnLocation record sent for this job</h6>
                                <pre class="bg-light p-2 small" style="max-height: 20rem; overflow: auto;">@row.PayloadJson</pre>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.ManualMatches.Any())
{
    <h4 class="mt-4">Manual matches</h4>
    <p class="text-muted">These records arrived during a sync with no linked Gallagher cardholder. Choose what to do for each one.</p>

    @foreach (var row in Model.ManualMatches)
    {
        var detailId = $"manual-detail-{row.QueueId:N}";
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="row align-items-start">
                    <div class="col-md-4">
                        <h5 class="card-title mb-1">@row.Display</h5>
                        <p class="small text-muted mb-0">OnLocation id @row.SourceId · Record Group @RecordGroupDisplay.GetName(row.ProfileId)</p>
                        @if (!string.IsNullOrWhiteSpace(row.CandidateHref))
                        {
                            <p class="small mt-2 mb-0">
                                <strong>Suggested match:</strong> @row.CandidateDisplay
                                @if (row.Confidence > 0)
                                {
                                    <span class="text-muted">(@row.Confidence.ToString("P0") — @row.Reason)</span>
                                }
                            </p>
                        }
                        else
                        {
                            <p class="small text-muted mt-2 mb-0">No strong match found in Gallagher.</p>
                        }
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small" for="candidate-@row.QueueId">Match to existing cardholder</label>
                        <select class="form-select form-select-sm" id="candidate-@row.QueueId" name="candidateHref" form="match-form-@row.QueueId">
                            <option value="">-- select --</option>
                            @foreach (var option in row.CandidateOptions)
                            {
                                <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <form method="post" id="create-form-@row.QueueId" asp-page-handler="ResolveCreate" class="d-inline">
                            <input type="hidden" name="queueId" value="@row.QueueId" />
                            <button type="submit" class="btn btn-sm btn-success mb-1">Create new</button>
                        </form>
                        <form method="post" id="match-form-@row.QueueId" asp-page-handler="ResolveMatch" class="d-inline">
                            <input type="hidden" name="queueId" value="@row.QueueId" />
                            <button type="submit" class="btn btn-sm btn-primary mb-1">Match selected</button>
                        </form>
                        <form method="post" asp-page-handler="ResolveIgnore" class="d-inline">
                            <input type="hidden" name="queueId" value="@row.QueueId" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary mb-1">Ignore</button>
                        </form>
                    </div>
                </div>
                <button class="btn btn-sm btn-link ps-0 mt-2" type="button" data-bs-toggle="collapse" data-bs-target="#@detailId">Show OnLocation record</button>
                <div class="collapse" id="@detailId">
                    <pre class="bg-light p-2 small mt-2" style="max-height: 20rem; overflow: auto;">@row.SourceJson</pre>
                </div>
            </div>
        </div>
    }
}
