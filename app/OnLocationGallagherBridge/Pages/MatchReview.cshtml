@page
@model MatchReviewModel
@{
    ViewData["Title"] = "Match Review";
}

<div class="page-header">
    <h2>Initial Record Match</h2>
</div>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}

<partial name="_StatusBanner" model='new StatusBannerModel("Initial Record Match", Model.InitialMatchStatus)' />

<form method="post" id="matchReviewForm">
    <div class="mb-3">
        <label class="form-label">Record Group</label>
        <select class="form-select" asp-for="SelectedProfileId" asp-items="Model.ProfileOptions"></select>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-outline-secondary btn-sm" formaction="/MatchReview?handler=LoadInductions">Load inductions for this record group</button>
    </div>

    @if (Model.InductionOptions.Any())
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h6 class="card-title">Inductions to pull through</h6>
                <p class="small text-muted">Only ticked inductions are scanned, for the initial match and for ongoing sync. Each unticked induction saves a full holder scan.</p>
                @foreach (var induction in Model.InductionOptions)
                {
                    <input type="hidden" name="OfferedInductionIds" value="@induction.Id" />
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedInductionIds" value="@induction.Id"
                               id="induction-@induction.Id" checked="@induction.Selected" />
                        <label class="form-check-label" for="induction-@induction.Id">
                            @induction.Name
                            <span class="text-muted small">(id @induction.Id@(induction.HolderCount.HasValue ? $", {induction.HolderCount} holders" : ""))</span>
                        </label>
                    </div>
                }
            </div>
        </div>
    }

    <div class="mb-3">
        <label class="form-label" asp-for="CompletedSinceDays">Include induction records completed within the last</label>
        <div class="input-group" style="max-width: 16rem">
            <input class="form-control" type="number" min="1" asp-for="CompletedSinceDays" />
            <span class="input-group-text">days</span>
        </div>
    </div>
    <div class="mb-3" style="max-width: 24rem">
        <label class="form-label" asp-for="GlobalResolution">Default resolution for records without an automatic match</label>
        <select class="form-select" asp-for="GlobalResolution">
            <option value="">-- choose per record --</option>
            <option value="Create">Create new</option>
            <option value="Exclude">Exclude from sync</option>
        </select>
    </div>
    <input type="hidden" asp-for="PreviewRequestId" id="previewRequestId" />
    <button type="submit" class="btn btn-secondary" formaction="/MatchReview?handler=Preview" id="buildPreviewButton">Build initial match review</button>
    <a class="btn @(Model.InitialMatchStatus == ConfigurationStatus.Complete ? "btn-primary" : "btn-outline-secondary disabled")" asp-page="/Index">Go to dashboard</a>

    <div class="card mt-3 shadow-sm @(Model.AutoLoad ? "" : "d-none")" id="previewProgress" data-autoload="@(Model.AutoLoad.ToString().ToLowerInvariant())" data-request-id="@(Request.Query["previewRequestId"].FirstOrDefault() ?? Model.PreviewRequestId)">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status" id="previewSpinner"></div>
                <span id="previewComplete" class="badge rounded-pill d-none"></span>
                <div>
                    <strong id="previewStatus">Preparing initial match review</strong>
                    <div id="previewDetail" class="text-muted small"></div>
                </div>
                <span id="previewElapsed" class="text-muted small ms-auto"></span>
            </div>
            <div class="progress mt-3" role="progressbar"><div class="progress-bar" id="previewProgressBar" style="width: 0%"></div></div>
            <ol class="list-group list-group-numbered list-group-flush mt-3">
                <li class="list-group-item" data-preview-step="1"><span class="badge text-bg-secondary rounded-pill me-2">1</span> Check connections</li>
                <li class="list-group-item" data-preview-step="2"><span class="badge text-bg-secondary rounded-pill me-2">2</span> Retrieve OnLocation records and inductions</li>
                <li class="list-group-item" data-preview-step="3"><span class="badge text-bg-secondary rounded-pill me-2">3</span> Retrieve Gallagher cardholders and calculate matches</li>
                <li class="list-group-item" data-preview-step="4"><span class="badge text-bg-secondary rounded-pill me-2">4</span> Prepare review</li>
            </ol>
        </div>
    </div>

@if (Model.Totals is not null)
{
    <div class="card mt-3 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Review and confirm</h5>
            <p class="small text-muted mb-3">Resolve every OnLocation record before confirming. Records that still need attention are shown at the top.</p>
            <div class="row row-cols-2 row-cols-md-4 g-3 text-center">
                <div class="col">
                    <div class="fs-4 fw-semibold">@Model.Totals.OnLocationRecords</div>
                    <div class="small text-muted">OnLocation records in window</div>
                </div>
                <div class="col">
                    <div class="fs-4 fw-semibold">@Model.Totals.GallagherCardholders</div>
                    <div class="small text-muted">Gallagher cardholders</div>
                </div>
                <div class="col">
                    <div class="fs-4 fw-semibold">@Model.Totals.SkippedNoName</div>
                    <div class="small text-muted">Skipped (no usable name)</div>
                </div>
                @if (Model.Rows.Any())
                {
                    <div class="col">
                        <div class="fs-4 fw-semibold text-danger" id="summaryUnresolved">@Model.Rows.Count(r => string.IsNullOrWhiteSpace(r.Resolution))</div>
                        <div class="small text-muted">Need attention</div>
                    </div>
                    <div class="col">
                        <div class="fs-4 fw-semibold text-success" id="summaryMatched">@Model.Rows.Count(r => r.Resolution == "Match")</div>
                        <div class="small text-muted">Match</div>
                    </div>
                    <div class="col">
                        <div class="fs-4 fw-semibold" id="summaryCreated">@Model.Rows.Count(r => r.Resolution == "Create")</div>
                        <div class="small text-muted">Create</div>
                    </div>
                    <div class="col">
                        <div class="fs-4 fw-semibold" id="summaryExcluded">@Model.Rows.Count(r => r.Resolution == "Exclude")</div>
                        <div class="small text-muted">Exclude</div>
                    </div>
                }
            </div>
            @if (Model.Rows.Any())
            {
                <div id="readyMessage" class="alert alert-success mt-3 mb-0 d-none">All records have a solution. You can now confirm and enable sync.</div>
                <div class="mt-3 d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-primary" id="openConfirmModal" disabled>Confirm initial match and enable sync</button>
                    <span id="confirmHint" class="small text-muted">Resolve every record before confirming.</span>
                </div>
            }
        </div>
    </div>
}

@if (Model.Rows.Any())
{
    <div class="alert alert-light border d-flex align-items-end gap-3">
        <div>
            <label class="form-label" for="applyGlobalResolution">Apply default to unresolved records</label>
            <select class="form-select" id="applyGlobalResolution">
                <option value="">-- select --</option>
                <option value="Create">Create new</option>
                <option value="Exclude">Exclude from sync</option>
            </select>
        </div>
        <button class="btn btn-outline-secondary" type="button" id="applyGlobalResolutionButton">Apply</button>
    </div>

    <div class="card mt-3 shadow-sm d-none" id="pushProgress">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status" id="pushSpinner"></div>
                <span id="pushComplete" class="badge rounded-pill d-none"></span>
                <div>
                    <strong id="pushStatus">Preparing to push changes to Gallagher</strong>
                    <div id="pushDetail" class="text-muted small"></div>
                </div>
            </div>
            <div class="progress mt-3"><div class="progress-bar" id="pushProgressBar" style="width: 0%"></div></div>
        </div>
    </div>
}
@if (Model.Rows.Any())
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>OnLocation record</th>
                <th>Resolution</th>
                <th>Gallagher cardholder</th>
                <th>Confidence</th>
                <th>Reason</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Rows.Count; i++)
            {
                <tr class="@(Model.Rows[i].CandidateHref is null ? "table-warning" : Model.Rows[i].RequiresReview ? "table-info" : "")">
                    <td>
                        <strong>@Model.Rows[i].SourceDisplay</strong>
                        <details class="mt-2">
                            <summary class="text-primary">View record properties (@Model.Rows[i].SourceProperties.Count)</summary>
                            <dl class="row small mt-2 mb-0">
                                @foreach (var property in Model.Rows[i].SourceProperties)
                                {
                                    <dt class="col-sm-5 text-break">@property.Name</dt>
                                    <dd class="col-sm-7 text-break">@property.Value</dd>
                                }
                            </dl>
                        </details>
                        <input type="hidden" asp-for="Rows[i].SourceId" />
                        <input type="hidden" asp-for="Rows[i].SourceDisplay" />
                        <input type="hidden" asp-for="Rows[i].SourceJson" />
                        <input type="hidden" asp-for="Rows[i].Confidence" />
                        <input type="hidden" asp-for="Rows[i].CandidateId" />
                        <input type="hidden" asp-for="Rows[i].CandidateDisplay" />
                        <input type="hidden" asp-for="Rows[i].RequiresReview" />
                    </td>
                    <td>
                        <select class="form-select" asp-for="Rows[i].Resolution">
                            <option value="">-- resolve --</option>
                            <option value="Match">Match existing</option>
                            <option value="Create">Create new</option>
                            <option value="Exclude">Exclude from sync</option>
                        </select>
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(Model.Rows[i].CandidateHref) && !Model.Rows[i].RequiresReview)
                        {
                            <input type="hidden" asp-for="Rows[i].CandidateHref" />
                            <small class="text-muted">Automatically matched: @Model.Rows[i].CandidateDisplay</small>
                        }
                        else
                        {
                            <select class="form-select" asp-for="Rows[i].CandidateHref" data-candidate-select="1">
                                <option value="">-- select unmatched Gallagher cardholder --</option>
                                @if (!string.IsNullOrWhiteSpace(Model.Rows[i].CandidateHref))
                                {
                                    <option value="@Model.Rows[i].CandidateHref">@Model.Rows[i].CandidateDisplay</option>
                                }
                            </select>
                            @if (Model.Rows[i].RequiresReview)
                            {
                                <small class="text-muted">Suggested: @Model.Rows[i].CandidateDisplay. Confirm or choose another cardholder.</small>
                            }
                            else
                            {
                                <small class="text-muted">Only cardholders not automatically matched to another record are available.</small>
                            }
                        }
                    </td>
                    <td>@Model.Rows[i].Confidence</td>
                    <td>@Model.Rows[i].Reason</td>
                </tr>
            }
        </tbody>
    </table>
    <input type="hidden" asp-for="ApproveRequestId" id="approveRequestId" />

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalLabel">Confirm initial record match</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>This action will write changes to Gallagher Command Centre that can be difficult to reverse:</p>
                    <ul>
                        <li><span id="confirmMatched" class="fw-semibold">0</span> existing cardholder(s) will be linked and queued for sync.</li>
                        <li><span id="confirmCreated" class="fw-semibold">0</span> new cardholder(s) will be created immediately.</li>
                        <li><span id="confirmExcluded" class="fw-semibold">0</span> record(s) will be excluded from sync.</li>
                    </ul>
                    <div class="alert alert-warning">
                        <strong>Back up your Gallagher Command Centre configuration before continuing.</strong> Creating new cardholders and linking existing records is not easily undone.
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="backupConfirmed" />
                        <label class="form-check-label" for="backupConfirmed">I confirm that Command Centre has been backed up and I want to proceed.</label>
                    </div>
                    <div id="backupError" class="text-danger small mt-2 d-none">You must confirm the backup before proceeding.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmApproveButton">Confirm and enable sync</button>
                </div>
            </div>
        </div>
    </div>

    <template id="candidateOptions">@foreach (var option in Model.CandidateOptions){<option value="@option.Value">@option.Text</option>}</template>
}
@if (Model.PushStatus is not null)
{
    <div class="card mt-3 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">@(Model.PushStatus.IsSuccess ? "Initial match applied" : "Initial match completed with failures")</h5>
            <p>@Model.PushStatus.Detail</p>
            @if (Model.PushStatus.Errors.Any())
            {
                <ul class="small text-danger">
                @foreach (var error in Model.PushStatus.Errors)
                {
                    <li>@error</li>
                }
                </ul>
            }
        </div>
    </div>
}
</form>

@section Scripts
{
    <script>
        (() => {
            const form = document.getElementById('matchReviewForm');
            const buildButton = document.getElementById('buildPreviewButton');
            const requestId = document.getElementById('previewRequestId');
            const progress = document.getElementById('previewProgress');
            const status = document.getElementById('previewStatus');
            const progressBar = document.getElementById('previewProgressBar');
            const spinner = document.getElementById('previewSpinner');
            const complete = document.getElementById('previewComplete');
            const detail = document.getElementById('previewDetail');
            const elapsed = document.getElementById('previewElapsed');
            let pollTimer;
            let elapsedTimer;
            let elapsedStart;

            const formatElapsed = ms => {
                const totalSeconds = Math.floor(ms / 1000);
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                return `${minutes}:${seconds.toString().padStart(2, '0')}`;
            };

            const updateElapsed = () => {
                if (!elapsedStart) return;
                elapsed.textContent = `Elapsed: ${formatElapsed(Date.now() - elapsedStart)}`;
            };

            const stopTimers = () => {
                window.clearInterval(pollTimer);
                window.clearInterval(elapsedTimer);
            };

            const setStage = previewStatus => {
                const isComplete = previewStatus.step === 4;
                spinner.classList.toggle('d-none', isComplete);
                complete.classList.toggle('d-none', !isComplete);
                complete.classList.toggle('text-bg-success', previewStatus.isSuccess !== false);
                complete.classList.toggle('text-bg-danger', previewStatus.isSuccess === false);
                complete.textContent = previewStatus.isSuccess === false ? '!' : '✓';
                status.textContent = previewStatus.message;
                detail.textContent = previewStatus.detail || '';
                const percent = typeof previewStatus.progressPercent === 'number'
                    ? previewStatus.progressPercent
                    : Math.min(previewStatus.step, 4) * 25;
                progressBar.style.width = `${percent}%`;
                document.querySelectorAll('[data-preview-step]').forEach(item => {
                    const step = Number(item.dataset.previewStep);
                    const badge = item.querySelector('.badge');
                    badge.classList.toggle('text-bg-success', step < previewStatus.step);
                    badge.classList.toggle('text-bg-primary', step === previewStatus.step);
                    badge.classList.toggle('text-bg-secondary', step > previewStatus.step);
                    badge.textContent = step < previewStatus.step ? '✓' : String(step);
                });
                if (isComplete) stopTimers();
            };

            buildButton?.addEventListener('click', () => {
                progress.classList.remove('d-none');
                spinner.classList.remove('d-none');
                complete.classList.add('d-none');
                elapsedStart = Date.now();
                updateElapsed();
                elapsedTimer = window.setInterval(updateElapsed, 1000);
            });

            if (progress.dataset.autoload === 'true') {
                const autoloadRequestId = progress.dataset.requestId;
                const pollStatus = async () => {
                    try {
                        const response = await fetch(`/MatchReview?handler=PreviewStatus&requestId=${encodeURIComponent(autoloadRequestId)}&_=${Date.now()}`, { cache: 'no-cache' });
                        if (response.ok) {
                            const previewStatus = await response.json();
                            if (previewStatus) {
                                setStage(previewStatus);
                                if (previewStatus.step === 4 && previewStatus.isSuccess !== false) {
                                    window.location.reload();
                                }
                            }
                        }
                    } catch { }
                };
                pollStatus();
                pollTimer = window.setInterval(pollStatus, 750);
            }

            const candidateOptions = document.getElementById('candidateOptions');
            const fillCandidates = select => {
                if (!candidateOptions || select.dataset.candidatesLoaded) return;
                select.dataset.candidatesLoaded = '1';
                const existing = new Set(Array.from(select.options, option => option.value));
                const selected = select.value;
                const fragment = document.createDocumentFragment();
                candidateOptions.content.querySelectorAll('option').forEach(option => {
                    if (!existing.has(option.value)) fragment.appendChild(option.cloneNode(true));
                });
                select.appendChild(fragment);
                select.value = selected;
            };
            document.querySelectorAll('select[data-candidate-select]').forEach(select => {
                select.addEventListener('mousedown', () => fillCandidates(select));
                select.addEventListener('focus', () => fillCandidates(select));
                select.addEventListener('keydown', () => fillCandidates(select));
            });

            document.getElementById('applyGlobalResolutionButton')?.addEventListener('click', () => {
                const resolution = document.getElementById('applyGlobalResolution').value;
                if (!resolution) return;
                document.querySelectorAll('select[name$=".Resolution"]').forEach(select => {
                    if (!select.value) {
                        select.value = resolution;
                        select.dispatchEvent(new Event('change'));
                    }
                });
            });

            // Live summary and confirm-button enablement
            const resolutionSelects = document.querySelectorAll('select[name$=".Resolution"]');
            const confirmButton = document.getElementById('openConfirmModal');
            const confirmHint = document.getElementById('confirmHint');
            const summaryUnresolved = document.getElementById('summaryUnresolved');
            const summaryMatched = document.getElementById('summaryMatched');
            const summaryCreated = document.getElementById('summaryCreated');
            const summaryExcluded = document.getElementById('summaryExcluded');
            const readyMessage = document.getElementById('readyMessage');

            const updateSummary = () => {
                const rows = Array.from(resolutionSelects);
                const counts = { Match: 0, Create: 0, Exclude: 0 };
                let unresolved = 0;
                rows.forEach(select => {
                    if (select.value) counts[select.value] = (counts[select.value] || 0) + 1;
                    else unresolved++;
                });
                summaryMatched.textContent = counts.Match || 0;
                summaryCreated.textContent = counts.Create || 0;
                summaryExcluded.textContent = counts.Exclude || 0;
                summaryUnresolved.textContent = unresolved;
                const allResolved = unresolved === 0;
                if (confirmButton) confirmButton.disabled = !allResolved;
                if (confirmHint) confirmHint.classList.toggle('d-none', allResolved);
                if (readyMessage) readyMessage.classList.toggle('d-none', !allResolved);
            };

            resolutionSelects.forEach(select => select.addEventListener('change', updateSummary));
            updateSummary();

            // Initial match confirmation modal and push progress
            const openConfirmModal = document.getElementById('openConfirmModal');
            const confirmModal = document.getElementById('confirmModal');
            const confirmApproveButton = document.getElementById('confirmApproveButton');
            const backupConfirmed = document.getElementById('backupConfirmed');
            const backupError = document.getElementById('backupError');
            const approveRequestId = document.getElementById('approveRequestId');
            const pushProgress = document.getElementById('pushProgress');
            const pushStatus = document.getElementById('pushStatus');
            const pushDetail = document.getElementById('pushDetail');
            const pushProgressBar = document.getElementById('pushProgressBar');
            const pushSpinner = document.getElementById('pushSpinner');
            const pushComplete = document.getElementById('pushComplete');
            let pushPollTimer;

            const updatePushStatus = status => {
                const isComplete = status.isComplete;
                pushSpinner.classList.toggle('d-none', isComplete);
                pushComplete.classList.toggle('d-none', !isComplete);
                pushComplete.classList.toggle('text-bg-success', isComplete && status.isSuccess);
                pushComplete.classList.toggle('text-bg-danger', isComplete && !status.isSuccess);
                pushComplete.textContent = isComplete ? (status.isSuccess ? '✓' : '!') : '';
                pushStatus.textContent = status.message;
                pushDetail.textContent = status.detail || '';
                const percent = status.total > 0 ? (status.processed / status.total * 100) : 0;
                pushProgressBar.style.width = `${percent}%`;
            };

            if (openConfirmModal && confirmModal) {
                openConfirmModal.addEventListener('click', () => {
                    const rows = Array.from(document.querySelectorAll('select[name$=".Resolution"]'));
                    const counts = { Match: 0, Create: 0, Exclude: 0 };
                    rows.forEach(select => {
                        if (select.value) counts[select.value] = (counts[select.value] || 0) + 1;
                    });
                    document.getElementById('confirmMatched').textContent = counts.Match || 0;
                    document.getElementById('confirmCreated').textContent = counts.Create || 0;
                    document.getElementById('confirmExcluded').textContent = counts.Exclude || 0;
                    backupError.classList.add('d-none');
                    const modal = bootstrap.Modal.getInstance(confirmModal) || new bootstrap.Modal(confirmModal);
                    modal.show();
                });
            }

            if (confirmApproveButton) {
                confirmApproveButton.addEventListener('click', async () => {
                    if (!backupConfirmed.checked) {
                        backupError.classList.remove('d-none');
                        return;
                    }
                    backupError.classList.add('d-none');
                    confirmApproveButton.disabled = true;
                    const modal = bootstrap.Modal.getInstance(confirmModal);
                    modal?.hide();
                    const requestId = window.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random()}`;
                    approveRequestId.value = requestId;
                    pushProgress.classList.remove('d-none');
                    pushSpinner.classList.remove('d-none');
                    pushComplete.classList.add('d-none');

                    const profileId = document.getElementById('SelectedProfileId')?.value ?? '';
                    const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    console.log('form contains table:', form.contains(document.querySelector('table')));
                    console.log('row input sample:', [...document.querySelectorAll('[name^="Rows["]')].slice(0, 3).map(e => e.name));
                    const formData = new FormData(form);
                    formData.set('handler', 'StartApprove');
                    formData.set('BackupConfirmed', backupConfirmed.checked ? 'true' : 'false');
                    formData.set(approveRequestId.name, requestId);
                    console.log('StartApprove BackupConfirmed:', formData.get('BackupConfirmed'));
                    console.log('StartApprove row keys:', [...formData.keys()].filter(k => k.startsWith('Rows[')).length);

                    let started = false;
                    try {
                        const response = await fetch('/MatchReview?handler=StartApprove', {
                            method: 'POST',
                            body: formData,
                            headers: token ? { 'RequestVerificationToken': token } : {}
                        });
                        if (response.ok) {
                            const result = await response.json();
                            if (result.success) {
                                started = true;
                            } else {
                                pushStatus.textContent = result.message || 'Could not start approval.';
                                pushSpinner.classList.add('d-none');
                                pushComplete.classList.remove('d-none');
                                pushComplete.classList.add('text-bg-danger');
                                pushComplete.textContent = '!';
                            }
                        } else {
                            pushStatus.textContent = 'Server returned an error when starting approval.';
                            pushSpinner.classList.add('d-none');
                        }
                    } catch (err) {
                        pushStatus.textContent = 'Failed to start approval: ' + err;
                        pushSpinner.classList.add('d-none');
                    }

                    if (!started) return;

                    const pollStatus = async () => {
                        try {
                            const response = await fetch(`/MatchReview?handler=ApproveStatus&requestId=${encodeURIComponent(requestId)}&_=${Date.now()}`, { cache: 'no-cache' });
                            if (response.ok) {
                                const status = await response.json();
                                if (status) updatePushStatus(status);
                                if (status && status.isComplete) {
                                    window.clearInterval(pushPollTimer);
                                    window.location.href = `/MatchReview?pushRequestId=${encodeURIComponent(requestId)}&profileId=${encodeURIComponent(profileId)}`;
                                }
                            }
                        } catch { }
                    };
                    pollStatus();
                    pushPollTimer = window.setInterval(pollStatus, 750);
                });
            }
        })();
    </script>
}
