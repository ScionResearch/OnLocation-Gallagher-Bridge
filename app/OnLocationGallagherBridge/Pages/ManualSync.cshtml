@page
@model ManualSyncModel
@{
    ViewData["Title"] = "Manual Sync";
}

<h3>Manual Sync</h3>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label">Profile</label>
        <select class="form-select" asp-for="SelectedProfileId" asp-items="Model.ProfileOptions"></select>
    </div>
    <button type="submit" class="btn btn-primary">Run Sync</button>
</form>

<h4 class="mt-4">Recent Jobs</h4>
<table class="table table-sm table-striped">
    <thead><tr><th>Profile</th><th>Source</th><th>Status</th><th>Updated</th></tr></thead>
    <tbody>
        @foreach (var j in Model.RecentJobs)
        {
            <tr>
                <td>@j.ProfileId</td>
                <td>@Model.GetDisplay(j)</td>
                <td>@j.Status</td>
                <td>@j.UpdatedAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
    </tbody>
</table>
