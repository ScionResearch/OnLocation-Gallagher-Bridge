@model OnLocationGallagherBridge.Services.ConfigurationStatus
@{
    var (label, cssClass) = Model switch
    {
        ConfigurationStatus.NotConfigured => ("Not configured", "text-secondary"),
        ConfigurationStatus.Incomplete => ("Incomplete", "text-warning"),
        ConfigurationStatus.Faulty => ("Faulty", "text-danger"),
        ConfigurationStatus.Complete => ("Complete", "text-success"),
        _ => ("Unknown", "text-secondary")
    };
}
<span class="status-text @cssClass">@label</span>
