@page
@model OnLocationGallagherBridge.Pages.SetupModel
@using OnLocationGallagherBridge.Services
@{
    ViewData["Title"] = "Setup";
    var connectorComplete = Model.Status.ConnectorSettings == ConfigurationStatus.Complete;
    var mappingComplete = Model.Status.FieldMapping == ConfigurationStatus.Complete;
}

<div class="text-center mb-4">
    <h1 class="display-6">Setup</h1>
    <p class="text-muted">Follow the steps to connect OnLocation to Gallagher</p>
</div>

<div class="row g-4 align-items-stretch justify-content-center">
    <div class="col-md-3">
        <div class="card h-100 text-center shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem; background-color: #0d6efd; color: white; font-weight: bold;">1</div>
                <h5 class="card-title">Connector Settings</h5>
                <p class="card-text text-muted small">Enter the OnLocation and Gallagher API details and test the connections.</p>
                <div class="mt-auto">
                    <p class="mb-2">Status: <partial name="_ConfigurationStatus" model="Model.Status.ConnectorSettings" /></p>
                    <a class="btn btn-outline-primary btn-sm w-100" asp-page="/Settings">Configure</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-auto d-none d-md-flex align-items-center justify-content-center">
        <span style="font-size: 2rem; color: #adb5bd;">→</span>
    </div>

    <div class="col-md-3">
        <div class="card h-100 text-center shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem; background-color: #0d6efd; color: white; font-weight: bold;">2</div>
                <h5 class="card-title">Field Mapping</h5>
                <p class="card-text text-muted small">Map OnLocation fields to Gallagher cardholder fields and define matching rules.</p>
                <div class="mt-auto">
                    <p class="mb-2">Status: <partial name="_ConfigurationStatus" model="Model.Status.FieldMapping" /></p>
                    @if (connectorComplete)
                    {
                        <a class="btn btn-outline-primary btn-sm w-100" asp-page="/Mapping">Configure</a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm w-100" disabled title="Complete Connector Settings first">Locked</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-auto d-none d-md-flex align-items-center justify-content-center">
        <span style="font-size: 2rem; color: #adb5bd;">→</span>
    </div>

    <div class="col-md-3">
        <div class="card h-100 text-center shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem; background-color: #0d6efd; color: white; font-weight: bold;">3</div>
                <h5 class="card-title">Initial Record Match</h5>
                <p class="card-text text-muted small">Review the first records, resolve any matches, and push them to Gallagher.</p>
                <div class="mt-auto">
                    <p class="mb-2">Status: <partial name="_ConfigurationStatus" model="Model.Status.InitialMatch" /></p>
                    @if (mappingComplete)
                    {
                        <a class="btn btn-outline-primary btn-sm w-100" asp-page="/MatchReview">Configure</a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm w-100" disabled title="Complete Field Mapping first">Locked</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 shadow-sm">
    <div class="card-body text-center">
        <h5 class="card-title">Overall setup status</h5>
        <p class="card-text">The bridge is ready to sync when all steps show <span class="badge bg-success">Complete</span>.</p>
        <p class="mb-0">Current state: <partial name="_ConfigurationStatus" model="Model.Status.Overall" /></p>
    </div>
</div>
