@page
@model MappingModel
@{
    ViewData["Title"] = "Field Mapping";
}

<h3>Field Mapping</h3>
<div class="form-check form-switch mb-3">
    <input class="form-check-input" type="checkbox" role="switch" id="showAllSourceFields" />
    <label class="form-check-label" for="showAllSourceFields">Show all OnLocation fields</label>
</div>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}

<partial name="_StatusBanner" model='new StatusBannerModel("Field Mapping", Model.FieldMappingStatus)' />

<form method="post">
    <div class="mb-3">
        <label class="form-label">Sync Profile</label>
        <select class="form-select" asp-for="SelectedProfileId" asp-items="Model.ProfileOptions"></select>
    </div>
    <input type="hidden" asp-for="LoadRequestId" id="loadRequestId" />
    <button type="submit" class="btn btn-secondary" formaction="/Mapping?handler=Load" id="loadFieldsButton">Get OnLocation &amp; Gallagher Fields</button>
    <button type="submit" class="btn btn-primary" formaction="/Mapping?handler=Save" id="saveMappingButton">Save mapping</button>
    <div id="loadFieldsProgress" class="card border-primary mt-3 d-none" role="status" aria-live="polite">
        <div class="card-body py-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div id="loadFieldsSpinner" class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
                <span id="loadFieldsComplete" class="badge rounded-pill text-bg-success d-none" aria-hidden="true">✓</span>
                <strong id="loadFieldsStatus">Requesting OnLocation and Gallagher field data…</strong>
            </div>
            <div class="progress mb-3" aria-label="Loading fields">
                <div id="loadFieldsProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
            </div>
            <ul class="list-unstyled mb-2 small">
                <li data-load-step="1"><span class="badge text-bg-secondary me-2">1</span>OnLocation profile records</li>
                <li data-load-step="2"><span class="badge text-bg-secondary me-2">2</span>OnLocation inductions and holder records</li>
                <li data-load-step="3"><span class="badge text-bg-secondary me-2">3</span>Gallagher cardholder fields, divisions and access groups</li>
            </ul>
            <div class="small text-muted">This can take a little while. Keep this page open while the field data is retrieved.</div>
        </div>
    </div>

<h4 class="mt-4">Defaults for new cardholders</h4>
<p>Applied only when the bridge creates a cardholder. Existing cardholders keep the division and access groups they already have.</p>
<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label" asp-for="DefaultDivisionHref">Division <span class="text-danger">*</span></label>
        <select class="form-select" asp-for="DefaultDivisionHref">
            <option value="">-- none selected --</option>
            @if (!Model.DefaultDivisionIsListed)
            {
                <option value="@Model.DefaultDivisionHref">@Model.DefaultDivisionHref</option>
            }
            @foreach (var division in Model.DivisionOptions)
            {
                <option value="@division.Href">@division.Name</option>
            }
        </select>
        <div class="form-text">Command Centre rejects a cardholder without a division, so this must be set before any cardholder can be created.</div>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label" asp-for="DefaultAccessGroupHrefs">Access groups</label>
        <select class="form-select" multiple size="8" asp-for="DefaultAccessGroupHrefs">
            @foreach (var group in Model.SelectedAccessGroupsNotListed())
            {
                <option value="@group.Href">@group.Name</option>
            }
            @foreach (var group in Model.AccessGroupOptions)
            {
                <option value="@group.Href">@group.Name</option>
            }
        </select>
        <div class="form-text">Optional. Hold Ctrl (or Cmd) to select more than one, or none to leave new cardholders without access.</div>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label" asp-for="DefaultUnmatchedAction">Default action for unmatched records</label>
        <select class="form-select" asp-for="DefaultUnmatchedAction">
            <option value="ManualReview">Manual review</option>
            <option value="CreateNew">Create new cardholder</option>
            <option value="Ignore">Ignore</option>
        </select>
        <div class="form-text">What the bridge should do when a synced OnLocation record has no matching Gallagher cardholder.</div>
    </div>
</div>
@if (!Model.DivisionOptions.Any())
{
    <div class="alert alert-warning py-2 small">Divisions and access groups have not been retrieved yet. Click <strong>Get OnLocation &amp; Gallagher Fields</strong> to populate these lists.</div>
}

<h4 class="mt-4">Bridge sync message</h4>
<p>Choose where to record a short timestamped message each time the bridge creates or updates a cardholder. Select <em>none</em> to leave cardholder fields untouched.</p>
<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label" asp-for="BridgeMessageTarget">Target field</label>
        <select class="form-select" asp-for="BridgeMessageTarget">
            <option value="">-- none --</option>
            <option value="description">Description</option>
            @{
                var savedTarget = Model.BridgeMessageTarget;
                var savedFieldName = savedTarget.StartsWith("personalDataFields.", StringComparison.OrdinalIgnoreCase)
                    ? savedTarget["personalDataFields.".Length..]
                    : savedTarget;
                var savedFieldInList = !string.IsNullOrWhiteSpace(savedTarget)
                    && Model.GallagherPersonalDataFieldNames.Any(f => string.Equals($"personalDataFields.{f}", savedTarget, StringComparison.OrdinalIgnoreCase));
            }
            @if (!string.IsNullOrWhiteSpace(savedTarget) && !savedFieldInList && !string.Equals(savedTarget, "description", StringComparison.OrdinalIgnoreCase))
            {
                <option value="@savedTarget">@savedFieldName</option>
            }
            @if (Model.GallagherPersonalDataFieldNames.Any())
            {
                <optgroup label="Personal Data Fields">
                    @foreach (var f in Model.GallagherPersonalDataFieldNames)
                    {
                        <option value="@($"personalDataFields.{f}")">@f</option>
                    }
                </optgroup>
            }
        </select>
        <div class="form-text">The description field may be visible to Gallagher operators, so a personal data field is usually a safer choice.</div>
    </div>
</div>

@if (Model.SourceFields.Any() || Model.InductionFieldGroups.Any() || Model.GallagherFields.Any() || Model.GallagherPersonalDataFieldNames.Any() || Model.GallagherCompetencyNames.Any())
{
    <h4 class="mt-4">Available fields</h4>
    <div class="row">
        <div class="col-md-6">
            <h5>OnLocation</h5>
            @if (Model.SourceFields.Any())
            {
                <h6 class="text-muted">Profile record</h6>
                <ul class="list-group mb-2" data-filterable-list>
                    @foreach (var f in Model.SourceFields)
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between" data-low-priority="@(!Model.IsPriorityProfileField(f))"><span>@f</span><small class="text-muted">@Model.ExampleFor(Model.SourceFieldExamples, f)</small></li>
                    }
                </ul>
            }
            @foreach (var induction in Model.InductionFieldGroups)
            {
                <h6 class="text-muted">@induction.Name (ID @induction.Id)</h6>
                <ul class="list-group mb-3" data-filterable-list>
                    @foreach (var f in induction.Fields)
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between" data-low-priority="@(!Model.IsPriorityInductionField(f))"><span>@f</span><small class="text-muted">@Model.ExampleFor(induction.Examples, f)</small></li>
                    }
                </ul>
            }
        </div>
        <div class="col-md-6">
            <h5>Gallagher</h5>
            @if (Model.GallagherFields.Any())
            {
                <h6 class="text-muted">Cardholder</h6>
                <ul class="list-group mb-2">
                    @foreach (var f in Model.GallagherFields)
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between"><span>@f</span><small class="text-muted">@Model.ExampleFor(Model.GallagherFieldExamples, f)</small></li>
                    }
                </ul>
            }
            @if (Model.GallagherPersonalDataFieldNames.Any())
            {
                <h6 class="text-muted">Personal Data Fields</h6>
                <ul class="list-group mb-2">
                    @foreach (var f in Model.GallagherPersonalDataFieldNames)
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between"><span>@f</span><small class="text-muted">@Model.ExampleFor(Model.GallagherPersonalDataFieldExamples, f)</small></li>
                    }
                </ul>
            }
            @if (Model.GallagherCompetencyNames.Any())
            {
                <h6 class="text-muted">Competencies</h6>
                <ul class="list-group mb-3">
                    @foreach (var name in Model.GallagherCompetencyNames)
                    {
                        <li class="list-group-item py-1 fw-bold">@name</li>
                        <li class="list-group-item py-1 ps-4 d-flex justify-content-between"><small>@($"competencies.{name}.status")</small><small class="text-muted">@Model.ExampleFor(Model.GallagherCompetencyFieldExamples, $"competencies.{name}.status")</small></li>
                        <li class="list-group-item py-1 ps-4 d-flex justify-content-between"><small>@($"competencies.{name}.expires")</small><small class="text-muted">@Model.ExampleFor(Model.GallagherCompetencyFieldExamples, $"competencies.{name}.expires")</small></li>
                    }
                </ul>
            }
        </div>
    </div>

    @if (Model.SourceSample != null || Model.InductionSample != null || Model.GallagherSample != null)
    {
        <details>
            <summary>Raw sample data</summary>
            <div class="row mt-2">
                @if (Model.SourceSample != null)
                {
                    <div class="col-md-4">
                        <h6>OnLocation sample</h6>
                        <pre class="border p-2 bg-light"><code>@Model.SourceSample</code></pre>
                    </div>
                }
                @if (Model.InductionSample != null)
                {
                    <div class="col-md-4">
                        <h6>OnLocation induction sample</h6>
                        <pre class="border p-2 bg-light"><code>@Model.InductionSample</code></pre>
                    </div>
                }
                @if (Model.GallagherSample != null)
                {
                    <div class="col-md-4">
                        <h6>Gallagher sample</h6>
                        <pre class="border p-2 bg-light"><code>@Model.GallagherSample</code></pre>
                    </div>
                }
            </div>
        </details>
    }
}

<h4 class="mt-4">Field maps</h4>
<p>Map an OnLocation source field to a Gallagher target field. Choose <strong>Rule based</strong> to set the target only when conditions match.</p>
<table class="table table-sm" id="fieldMapsTable">
    <thead><tr><th>OnLocation source field</th><th>Gallagher target field</th><th>Transform</th></tr></thead>
    <tbody>
        @for (int i = 0; i < Model.FieldMaps.Count; i++)
        {
            var map = Model.FieldMaps[i];
            var isRuleBased = string.Equals(map.Transform, "rule-based", StringComparison.OrdinalIgnoreCase);
            <tr class="field-map-row">
                <td>
                    <select class="form-select" asp-for="FieldMaps[i].Source">
                        <option value="">-- select --</option>
                        @if (!string.IsNullOrWhiteSpace(Model.FieldMaps[i].Source))
                        {
                            <option value="@Model.FieldMaps[i].Source">@Model.FieldMaps[i].Source</option>
                        }
                        @if (Model.SourceFields.Any())
                        {
                            <optgroup label="Profile record">
                                @foreach (var f in Model.SourceFields)
                                {
                                    <option value="@f" data-low-priority="@(!Model.IsPriorityProfileField(f))">@f</option>
                                }
                            </optgroup>
                        }
                        @foreach (var induction in Model.InductionFieldGroups)
                        {
                            <optgroup label="@($"{induction.Name} (ID {induction.Id})")">
                                @foreach (var f in induction.Fields)
                                {
                                    <option value="@($"inductions.{induction.Id}.{f}")" data-low-priority="@(!Model.IsPriorityInductionField(f))">@($"{induction.Name} (ID {induction.Id}) · {f}")</option>
                                }
                            </optgroup>
                        }
                    </select>
                </td>
                <td>
                    <select class="form-select" asp-for="FieldMaps[i].Target">
                        <option value="">-- select --</option>
                        @if (!string.IsNullOrWhiteSpace(Model.FieldMaps[i].Target))
                        {
                            <option value="@Model.FieldMaps[i].Target">@Model.FieldMaps[i].Target</option>
                        }
                        @if (Model.GallagherFields.Any())
                        {
                            <optgroup label="Cardholder">
                                @foreach (var f in Model.GallagherFields)
                                {
                                    <option value="@f">@f</option>
                                }
                            </optgroup>
                        }
                        @if (Model.GallagherPersonalDataFieldNames.Any())
                        {
                            <optgroup label="Personal Data Fields">
                                @foreach (var f in Model.GallagherPersonalDataFieldNames)
                                {
                                    <option value="@($"personalDataFields.{f}")">@f</option>
                                }
                            </optgroup>
                        }
                        @if (Model.GallagherCompetencyNames.Any())
                        {
                            @foreach (var name in Model.GallagherCompetencyNames)
                            {
                                <optgroup label="@name">
                                    <option value="@($"competencies.{name}.status")">@($"{name} (status)")</option>
                                    <option value="@($"competencies.{name}.expires")">@($"{name} (expiry)")</option>
                                </optgroup>
                            }
                        }
                    </select>
                </td>
                <td>
                    <select class="form-select transform-select" asp-for="FieldMaps[i].Transform">
                        <option value="copy">Copy value</option>
                        <option value="first-name">First name (first word)</option>
                        <option value="last-name">Last name (remaining words)</option>
                        <option value="gallagher-expiry">Gallagher competency expiry (NZ end of day)</option>
                        <option value="rule-based">Rule based</option>
                    </select>
                </td>
            </tr>
            <tr class="rule-section @(!isRuleBased ? "d-none" : "")" data-map-index="@i">
                <td colspan="3" class="py-3 bg-light">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Rule logic</label>
                            <select class="form-select form-select-sm" asp-for="FieldMaps[i].RuleLogic">
                                <option value="and">All rules must match (AND)</option>
                                <option value="or">Any rule can match (OR)</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Output value when rules match</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input output-type" type="radio" name="outputType_@i" id="outputTypeConst_@i" value="constant" checked="@(string.IsNullOrWhiteSpace(map.RuleOutputSource))" />
                                <label class="form-check-label" for="outputTypeConst_@i">Constant</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input output-type" type="radio" name="outputType_@i" id="outputTypeSource_@i" value="source" checked="@(!string.IsNullOrWhiteSpace(map.RuleOutputSource))" />
                                <label class="form-check-label" for="outputTypeSource_@i">Source field</label>
                            </div>
                            <div class="output-constant mt-2 @(string.IsNullOrWhiteSpace(map.RuleOutputSource) ? "" : "d-none")">
                                <input class="form-control form-control-sm" asp-for="FieldMaps[i].RuleOutputValue" placeholder="Value to write" />
                                <div class="form-check mt-1">
                                    <input class="form-check-input" type="checkbox" asp-for="FieldMaps[i].RuleOutputIsNumber" />
                                    <label class="form-check-label" asp-for="FieldMaps[i].RuleOutputIsNumber">Value is a number</label>
                                </div>
                            </div>
                            <div class="output-source mt-2 @(!string.IsNullOrWhiteSpace(map.RuleOutputSource) ? "" : "d-none")">
                                <select class="form-select form-select-sm" asp-for="FieldMaps[i].RuleOutputSource">
                                    @Model.RenderSourceFieldOptions(map.RuleOutputSource)
                                </select>
                            </div>
                        </div>
                    </div>
                    <label class="form-label mt-3">Rules</label>
                    <table class="table table-sm table-borderless">
                        <tbody class="rule-rows">
                            @for (int j = 0; j < map.Rules.Count; j++)
                            {
                                var rule = map.Rules[j];
                                var ruleVisible = !string.IsNullOrWhiteSpace(rule.Source);
                                var valueIsSource = rule.ValueIsSource;
                                <tr class="rule-row @(ruleVisible ? "" : "d-none")" data-rule-index="@j">
                                    <td>
                                        <select class="form-select form-select-sm rule-source" asp-for="FieldMaps[i].Rules[j].Source">
                                            @Model.RenderSourceFieldOptions(rule.Source)
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm rule-operator" asp-for="FieldMaps[i].Rules[j].Operator">
                                            <option value="equals">equals</option>
                                            <option value="not-equals">does not equal</option>
                                            <option value="greater-than">greater than</option>
                                            <option value="less-than">less than</option>
                                            <option value="contains">contains</option>
                                            <option value="not-contains">does not contain</option>
                                            <option value="exists">exists</option>
                                        </select>
                                    </td>
                                    <td class="rule-value-cell">
                                        <input type="hidden" asp-for="FieldMaps[i].Rules[j].Value" class="rule-value-hidden" />
                                        <input type="text" class="form-control form-control-sm rule-value-constant @(valueIsSource ? "d-none" : "")" placeholder="Value" value="@rule.Value" />
                                        <select class="form-select form-select-sm rule-value-source @(!valueIsSource ? "d-none" : "")">
                                            @Model.RenderSourceFieldOptions(rule.Value)
                                        </select>
                                    </td>
                                    <td>
                                        <div class="form-check">
                                            <input class="form-check-input rule-value-issource" type="checkbox" asp-for="FieldMaps[i].Rules[j].ValueIsSource" />
                                            <label class="form-check-label" asp-for="FieldMaps[i].Rules[j].ValueIsSource">Use source field</label>
                                        </div>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-rule">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-primary add-rule">Add rule</button>
                    <small class="text-muted ms-2 rule-limit @(map.Rules.Count(r => !string.IsNullOrWhiteSpace(r.Source)) >= 10 ? "" : "d-none")">Maximum 10 rules reached.</small>
                </td>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-4">Primary match</h4>
<p>The first rule used to identify the same person across OnLocation and Gallagher. Select more than one field on either side to compare a combined value, for example OnLocation <code>name</code> against Gallagher <code>firstName</code> and <code>lastName</code>.</p>
<table class="table table-sm">
    <thead><tr><th>OnLocation fields</th><th>Gallagher fields</th><th>Match type</th></tr></thead>
    <tbody>
        <tr>
            <td>
                <select class="form-select" multiple size="6" asp-for="PrimaryMatch.SourceFieldList">
                    @foreach (var value in Model.UnlistedSourceFields(Model.PrimaryMatch))
                    {
                        <option value="@value">@value</option>
                    }
                    <optgroup label="Profile record">
                        @foreach (var field in Model.SourceFields)
                        {
                            <option value="@field" data-low-priority="@(!Model.IsPriorityProfileField(field))">@field</option>
                        }
                    </optgroup>
                    @foreach (var induction in Model.InductionFieldGroups)
                    {
                        <optgroup label="@($"{induction.Name} (ID {induction.Id})")">
                            @foreach (var field in induction.Fields)
                            {
                                <option value="@($"inductions.{induction.Id}.{field}")" data-low-priority="@(!Model.IsPriorityInductionField(field))">@($"{induction.Name} (ID {induction.Id}) · {field}")</option>
                            }
                        </optgroup>
                    }
                </select>
            </td>
            <td>
                <select class="form-select" multiple size="6" asp-for="PrimaryMatch.TargetFieldList">
                    @foreach (var value in Model.UnlistedTargetFields(Model.PrimaryMatch))
                    {
                        <option value="@value">@value</option>
                    }
                    <optgroup label="Cardholder">
                        @foreach (var field in Model.GallagherFields)
                        {
                            <option value="@field">@field</option>
                        }
                    </optgroup>
                    <optgroup label="Personal Data Fields">
                        @foreach (var field in Model.GallagherPersonalDataFieldNames)
                        {
                            <option value="@($"personalDataFields.{field}")">@field</option>
                        }
                    </optgroup>
                </select>
            </td>
            <td>
                <select class="form-select" asp-for="PrimaryMatch.MatchType">
                    <option value="exact">exact</option>
                    <option value="fuzzy">fuzzy</option>
                </select>
            </td>
        </tr>
    </tbody>
</table>

<h4 class="mt-4">Fallback match rules</h4>
<p>When the primary match or existing ID mapping does not find a result, try these rules in priority order. Hold Ctrl (or Cmd) to select several fields on either side; multiple fields are joined with a space before comparing, so a single combined OnLocation field can be matched against separate Gallagher fields.</p>
<table class="table table-sm">
    <thead><tr><th>OnLocation fields</th><th>Gallagher fields</th><th>Match type</th><th>Priority</th></tr></thead>
    <tbody>
        @for (int i = 0; i < Model.MatchRules.Count; i++)
        {
            <tr>
                <td>
                    <select class="form-select" multiple size="6" asp-for="MatchRules[i].SourceFieldList">
                    @foreach (var value in Model.UnlistedSourceFields(Model.MatchRules[i]))
                    {
                        <option value="@value">@value</option>
                    }
                    <optgroup label="Profile record">
                        @foreach (var field in Model.SourceFields)
                        {
                            <option value="@field" data-low-priority="@(!Model.IsPriorityProfileField(field))">@field</option>
                        }
                    </optgroup>
                    @foreach (var induction in Model.InductionFieldGroups)
                    {
                        <optgroup label="@($"{induction.Name} (ID {induction.Id})")">
                            @foreach (var field in induction.Fields)
                            {
                                <option value="@($"inductions.{induction.Id}.{field}")" data-low-priority="@(!Model.IsPriorityInductionField(field))">@($"{induction.Name} (ID {induction.Id}) · {field}")</option>
                            }
                        </optgroup>
                    }
                </select>
                </td>
                <td>
                    <select class="form-select" multiple size="6" asp-for="MatchRules[i].TargetFieldList">
                    @foreach (var value in Model.UnlistedTargetFields(Model.MatchRules[i]))
                    {
                        <option value="@value">@value</option>
                    }
                    <optgroup label="Cardholder">
                        @foreach (var field in Model.GallagherFields)
                        {
                            <option value="@field">@field</option>
                        }
                    </optgroup>
                    <optgroup label="Personal Data Fields">
                        @foreach (var field in Model.GallagherPersonalDataFieldNames)
                        {
                            <option value="@($"personalDataFields.{field}")">@field</option>
                        }
                    </optgroup>
                </select>
                </td>
                <td>
                    <select class="form-select" asp-for="MatchRules[i].MatchType">
                        <option value="exact">exact</option>
                        <option value="fuzzy">fuzzy</option>
                    </select>
                </td>
                <td><input class="form-control" type="number" asp-for="MatchRules[i].Priority" /></td>
            </tr>
        }
    </tbody>
</table>

</form>

<script>
    (() => {
        const form = document.querySelector('form');
        const loadButton = document.getElementById('loadFieldsButton');
        const saveButton = document.getElementById('saveMappingButton');
        const progress = document.getElementById('loadFieldsProgress');
        const status = document.getElementById('loadFieldsStatus');
        const requestId = document.getElementById('loadRequestId');
        const progressBar = document.getElementById('loadFieldsProgressBar');
        const spinner = document.getElementById('loadFieldsSpinner');
        const complete = document.getElementById('loadFieldsComplete');
        const setStage = loadStatus => {
            const isComplete = loadStatus.step === 4;
            spinner.classList.toggle('d-none', isComplete);
            complete.classList.toggle('d-none', !isComplete);
            complete.classList.toggle('text-bg-success', loadStatus.isSuccess !== false);
            complete.classList.toggle('text-bg-danger', loadStatus.isSuccess === false);
            complete.textContent = loadStatus.isSuccess === false ? '!' : '✓';
            status.textContent = loadStatus.message;
            progressBar.style.width = `${Math.min(loadStatus.step, 4) * 25}%`;
            document.querySelectorAll('[data-load-step]').forEach(item => {
                const step = Number(item.dataset.loadStep);
                const badge = item.querySelector('.badge');
                badge.classList.toggle('text-bg-success', step < loadStatus.step);
                badge.classList.toggle('text-bg-primary', step === loadStatus.step);
                badge.classList.toggle('text-bg-secondary', step > loadStatus.step);
                badge.textContent = step < loadStatus.step ? '✓' : String(step);
            });
        };
        form.addEventListener('submit', event => {
            if (event.submitter !== loadButton) return;
            event.preventDefault();
            requestId.value = window.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random()}`;
            loadButton.disabled = true;
            saveButton.disabled = true;
            progress.classList.remove('d-none');
            const pollStatus = async () => {
                try {
                    const response = await fetch(`/Mapping?handler=LoadStatus&requestId=${encodeURIComponent(requestId.value)}`);
                    if (!response.ok) return;
                    const loadStatus = await response.json();
                    if (loadStatus) setStage(loadStatus);
                } catch {
                }
            };
            pollStatus();
            window.setInterval(pollStatus, 750);
            window.setTimeout(() => {
                form.action = loadButton.formAction;
                form.submit();
            }, 50);
        });

        const toggle = document.getElementById('showAllSourceFields');
        const updateVisibility = () => {
            document.querySelectorAll('[data-low-priority="True"], [data-low-priority="true"]').forEach(element => {
                const show = toggle.checked || element.selected;
                if (element.tagName === 'OPTION') {
                    element.hidden = !show;
                    element.disabled = !show;
                } else {
                    element.classList.toggle('d-none', !show);
                }
            });
            document.querySelectorAll('[data-filterable-list]').forEach(list => {
                const rows = Array.from(list.querySelectorAll(':scope > li'));
                const visibleRows = rows.filter(row => !row.classList.contains('d-none'));
                rows.forEach(row => row.classList.remove('rounded-top', 'border-top', 'rounded-bottom', 'border-bottom'));
                visibleRows[0]?.classList.add('rounded-top', 'border-top');
                visibleRows.at(-1)?.classList.add('rounded-bottom', 'border-bottom');
            });
        };
        toggle.addEventListener('change', updateVisibility);
        updateVisibility();

        // Rule-based transform UI
        const fieldMapsTable = document.getElementById('fieldMapsTable');
        const updateRuleValueVisibility = row => {
            const op = row.querySelector('.rule-operator').value;
            const cell = row.querySelector('.rule-value-cell');
            if (op === 'exists') {
                cell.classList.add('d-none');
                row.querySelector('.rule-value-hidden').value = '';
                row.querySelector('.rule-value-constant').value = '';
                row.querySelector('.rule-value-source').value = '';
                return;
            }
            cell.classList.remove('d-none');
            const isSource = row.querySelector('.rule-value-issource').checked;
            row.querySelector('.rule-value-constant').classList.toggle('d-none', isSource);
            row.querySelector('.rule-value-source').classList.toggle('d-none', !isSource);
        };
        const clearRuleRow = row => {
            row.querySelector('.rule-source').value = '';
            row.querySelector('.rule-operator').value = 'equals';
            row.querySelector('.rule-value-hidden').value = '';
            row.querySelector('.rule-value-constant').value = '';
            row.querySelector('.rule-value-source').value = '';
            row.querySelector('.rule-value-issource').checked = false;
            updateRuleValueVisibility(row);
        };
        const updateRuleLimit = section => {
            const total = section.querySelectorAll('.rule-row').length;
            const hidden = section.querySelectorAll('.rule-row.d-none').length;
            const limit = section.querySelector('.rule-limit');
            if (limit) limit.classList.toggle('d-none', hidden > 0);
        };
        const setOutputVisibility = section => {
            const isSource = section.querySelector('input[type="radio"][value="source"]').checked;
            section.querySelector('.output-constant').classList.toggle('d-none', isSource);
            section.querySelector('.output-source').classList.toggle('d-none', !isSource);
        };
        if (fieldMapsTable) {
            fieldMapsTable.addEventListener('change', e => {
                if (e.target.classList.contains('transform-select')) {
                    const row = e.target.closest('.field-map-row');
                    const section = row?.nextElementSibling;
                    if (section?.classList.contains('rule-section')) {
                        section.classList.toggle('d-none', e.target.value !== 'rule-based');
                    }
                }
            });
            fieldMapsTable.addEventListener('click', e => {
                const button = e.target.closest('.add-rule, .remove-rule');
                if (!button) return;
                if (button.classList.contains('add-rule')) {
                    const section = button.closest('.rule-section');
                    const hiddenRow = Array.from(section.querySelectorAll('.rule-row')).find(r => r.classList.contains('d-none'));
                    if (hiddenRow) {
                        hiddenRow.classList.remove('d-none');
                        clearRuleRow(hiddenRow);
                        updateRuleLimit(section);
                    }
                } else if (button.classList.contains('remove-rule')) {
                    const row = button.closest('.rule-row');
                    row.classList.add('d-none');
                    clearRuleRow(row);
                    updateRuleLimit(row.closest('.rule-section'));
                }
            });
            fieldMapsTable.addEventListener('change', e => {
                if (e.target.classList.contains('rule-operator') || e.target.classList.contains('rule-value-issource')) {
                    updateRuleValueVisibility(e.target.closest('.rule-row'));
                }
                if (e.target.classList.contains('output-type')) {
                    const section = e.target.closest('.rule-section');
                    setOutputVisibility(section);
                }
            });
            fieldMapsTable.addEventListener('input', e => {
                if (e.target.classList.contains('rule-value-constant')) {
                    const row = e.target.closest('.rule-row');
                    row.querySelector('.rule-value-hidden').value = e.target.value;
                }
            });
            fieldMapsTable.addEventListener('change', e => {
                if (e.target.classList.contains('rule-value-source')) {
                    const row = e.target.closest('.rule-row');
                    row.querySelector('.rule-value-hidden').value = e.target.value;
                }
            });
        }
        document.querySelectorAll('.rule-row').forEach(updateRuleValueVisibility);
        document.querySelectorAll('.rule-section').forEach(section => {
            const checkedRadio = section.querySelector('input[type="radio"]:checked');
            if (checkedRadio) {
                setOutputVisibility(section);
            }
            updateRuleLimit(section);
        });
    })();
</script>
